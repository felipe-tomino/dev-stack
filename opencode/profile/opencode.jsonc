{
	"$schema": "https://opencode.ai/config.json",
	"model": "openai/gpt-5.6-sol",
	"small_model": "openai/gpt-5.6-luna",
	"default_agent": "build",
	"subagent_depth": 1,
	"provider": {
		"openai": {
			"options": {
				"headerTimeout": 300000,
				"chunkTimeout": 180000
			}
		}
	},
	"agent": {
		"general": {
			"disable": true
		}
	},
	"plugin": [
		"@tarquinen/opencode-dcp@3.1.15"
	],
	"permission": {
		"task": "deny",
		"work_spec_read": "deny",
		"work_spec_write": "deny",
		"github_source_*": "deny",
		"herdr_worktree_*": "deny",
		"context7_*": "deny",
		"exa_*": "deny",
		"gh_grep_*": "deny",
		"webfetch": "deny"
	},
	"mcp": {
		"github-read": {
			"enabled": false
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"exa": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp",
			"enabled": true
		},
		"gh_grep": {
			"type": "remote",
			"url": "https://mcp.grep.app",
			"enabled": true
		}
	},
	"instructions": [
		"./tools/philosophy.md",
		"./tools/communication.md",
		"./tools/lean-workflow.md",
		"./tools/herdr-worktrees.md",
		"./tools/tool-execution.md"
	]
}

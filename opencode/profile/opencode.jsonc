{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "build",
	"subagent_depth": 1,
	"provider": {
		"openai": {
			"options": {
				"headerTimeout": 300000,
				"chunkTimeout": 180000
			}
		}
	},
	"agent": {
		"general": {
			"disable": true
		}
	},
	"permission": {
		"task": "deny",
		"context7_*": "deny",
		"exa_*": "deny",
		"gh_grep_*": "deny",
		"webfetch": "deny",
		"external_directory": {
			"~/repos/**": "allow",
			"~/.herdr/worktrees/**": "allow"
		}
	},
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"exa": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp",
			"enabled": true
		},
		"gh_grep": {
			"type": "remote",
			"url": "https://mcp.grep.app",
			"enabled": true
		}
	},
	"instructions": [
		"./tools/philosophy.md",
		"./tools/lean-workflow.md",
		"./tools/herdr-worktrees.md"
	]
}
